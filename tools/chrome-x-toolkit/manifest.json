{
  "manifest_version": 3,
  "name": "X 工具箱",
  "version": "1.0.0",
  "description": "X/Twitter：按日期批量删除推文/回复/转发/喜欢；贴文详情页 AI 评论生成",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.twimg.com/*",
    "http://127.0.0.1:11434/*",
    "http://localhost:11434/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X 工具箱",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["x-api.js", "comment-panel.js", "batch-overlay.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
