{
  "manifest_version": 3,
  "name": "评论角度助手",
  "version": "1.1.1",
  "description": "X / 币安 / OKX / Bitget / Reddit 贴文上下文 → 多角色评论候选 → 填入或复制",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "http://127.0.0.1:11434/*",
    "http://localhost:11434/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "评论角度助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["platforms.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
